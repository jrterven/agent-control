<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-control.hermes-serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SERVE_WRAPPER__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMES_BIN</key>
    <string>__HERMES_BIN__</string>
    <key>HERMES_PROFILE</key>
    <string>default</string>
    <key>HERMES_PORT</key>
    <string>9119</string>
    <key>HERMES_TUI_WS_ORPHAN_REAP_GRACE_S</key>
    <string>300</string>
    <key>HERMES_TOKEN_KEYCHAIN_ACCOUNT</key>
    <string>__MACOS_USER__</string>
    <key>HERMES_TOKEN_KEYCHAIN_SERVICE</key>
    <string>com.agent-control.hermes-dashboard</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/hermes-serve.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/hermes-serve.error.log</string>
</dict>
</plist>
