<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-control.hermes-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__TUNNEL_WRAPPER__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMES_LOCAL_PORT</key>
    <string>9119</string>
    <key>HERMES_CONTROL_REMOTE_PORT</key>
    <string>29119</string>
    <key>HERMES_CONTROL_SSH_TARGET</key>
    <string>__SSH_TARGET__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/hermes-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/hermes-tunnel.error.log</string>
</dict>
</plist>
