<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by deploy/install-macos.sh -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-control.control</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CONTROL_WRAPPER__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMES_CONTROL_RELEASE_ROOT</key>
    <string>__RELEASE_ROOT__</string>
    <key>HERMES_CONTROL_ENV_FILE</key>
    <string>__ENV_FILE__</string>
    <key>HERMES_CONTROL_PORT</key>
    <string>8000</string>
    <key>HERMES_TOKEN_KEYCHAIN_ACCOUNT</key>
    <string>__MACOS_USER__</string>
    <key>HERMES_TOKEN_KEYCHAIN_SERVICE</key>
    <string>com.agent-control.hermes-dashboard</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/control.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/control.error.log</string>
</dict>
</plist>
