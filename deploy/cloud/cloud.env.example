# Install outside the repository, owned by the operator, mode 0600.
# Percent-encode any special characters in the PostgreSQL password.
HERMES_CONTROL_ENVIRONMENT=production
HERMES_CONTROL_DEPLOYMENT_MODE=cloud
HERMES_CONTROL_DATABASE_URL=postgresql+psycopg://agent_control:REPLACE@postgres/agent_control
HERMES_CONTROL_PUBLIC_BASE_URL=https://control.example.com
HERMES_CONTROL_ALLOWED_ORIGINS=["https://control.example.com"]
HERMES_CONTROL_VAULT_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_KEY
HERMES_CONTROL_GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
HERMES_CONTROL_GOOGLE_CLIENT_SECRET=REPLACE
# Mail OAuth is separate from platform sign-in. Enable only after provider validation.
HERMES_CONTROL_MAIL_IMAP_ENABLED=true
HERMES_CONTROL_MAIL_GMAIL_ENABLED=false
HERMES_CONTROL_MAIL_GMAIL_CLIENT_ID=
HERMES_CONTROL_MAIL_GMAIL_CLIENT_SECRET=
HERMES_CONTROL_MAIL_OUTLOOK_ENABLED=false
HERMES_CONTROL_MAIL_OUTLOOK_CLIENT_ID=
HERMES_CONTROL_MAIL_OUTLOOK_CLIENT_SECRET=
# Set open to accept Google registrations without an invitation, up to the cap.
# Existing deployments default to invite_only when this setting is absent.
HERMES_CONTROL_CLOUD_REGISTRATION_MODE=invite_only
HERMES_CONTROL_BETA_MAX_USERS=20
HERMES_CONTROL_SECURE_COOKIES=true
HERMES_CONTROL_PROVIDER_MODE=real
HERMES_CONTROL_MOCK_FALLBACK_ENABLED=false
HERMES_CONTROL_TRUST_PRIVATE_ENDPOINTS=false
HERMES_CONTROL_CREATE_SCHEMA_ON_START=false
HERMES_CONTROL_HERMES_MEDIA_ROOT=
HERMES_CONTROL_PUSH_VAPID_SUBJECT=mailto:operator@example.com
# Private product images. Use a separate R2 bucket and bucket-scoped credentials;
# never use the backup bucket or expose these values to connectors/the browser.
HERMES_CONTROL_VISUAL_MEDIA_ENDPOINT_URL=
HERMES_CONTROL_VISUAL_MEDIA_BUCKET=
HERMES_CONTROL_VISUAL_MEDIA_ACCESS_KEY_ID=
HERMES_CONTROL_VISUAL_MEDIA_SECRET_ACCESS_KEY=
HERMES_CONTROL_VISUAL_MEDIA_REGION=auto
HERMES_CONTROL_VISUAL_MEDIA_MAX_BYTES=10485760
HERMES_CONTROL_VISUAL_MEDIA_MAX_PIXELS=25000000
HERMES_CONTROL_VISUAL_MEDIA_MAX_IMAGES_PER_GALLERY=6
HERMES_CONTROL_VISUAL_MEDIA_MAX_IMAGES_PER_RESPONSE=24
HERMES_CONTROL_VISUAL_MEDIA_QUOTA_BYTES=5368709120
HERMES_CONTROL_VISUAL_MEDIA_RETENTION_DAYS=30
