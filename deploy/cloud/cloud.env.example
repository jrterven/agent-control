# Install outside the repository, owned by the operator, mode 0600.
# Percent-encode any special characters in the PostgreSQL password.
HERMES_CONTROL_ENVIRONMENT=production
HERMES_CONTROL_DEPLOYMENT_MODE=cloud
HERMES_CONTROL_DATABASE_URL=postgresql+psycopg://agent_control:REPLACE@postgres/agent_control
HERMES_CONTROL_PUBLIC_BASE_URL=https://control.example.com
HERMES_CONTROL_ALLOWED_ORIGINS=["https://control.example.com"]
HERMES_CONTROL_VAULT_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_KEY
HERMES_CONTROL_GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
HERMES_CONTROL_GOOGLE_CLIENT_SECRET=REPLACE
HERMES_CONTROL_BETA_MAX_USERS=20
HERMES_CONTROL_SECURE_COOKIES=true
HERMES_CONTROL_PROVIDER_MODE=real
HERMES_CONTROL_MOCK_FALLBACK_ENABLED=false
HERMES_CONTROL_TRUST_PRIVATE_ENDPOINTS=false
HERMES_CONTROL_CREATE_SCHEMA_ON_START=false
HERMES_CONTROL_HERMES_MEDIA_ROOT=
HERMES_CONTROL_PUSH_VAPID_SUBJECT=mailto:operator@example.com
