# Copy to an untracked file and replace every placeholder.
HERMES_CONTROL_ENVIRONMENT=development
HERMES_CONTROL_DATABASE_URL=sqlite:///./hermes-control.db
HERMES_CONTROL_STATIC_DIR=apps/api/static
HERMES_CONTROL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HERMES_CONTROL_SECURE_COOKIES=false
HERMES_CONTROL_SESSION_TTL_HOURS=12
HERMES_CONTROL_REALTIME_TICKET_TTL_SECONDS=30
HERMES_CONTROL_CAPABILITY_TTL_SECONDS=60
HERMES_CONTROL_CAPABILITY_REFRESH_SECONDS=30
HERMES_CONTROL_CREATE_SCHEMA_ON_START=false
HERMES_CONTROL_VAULT_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_KEY
# Select mock explicitly for offline development. Real session operations are
# never redirected into an in-memory identity when a tunnel goes down.
HERMES_CONTROL_PROVIDER_MODE=real
HERMES_CONTROL_MOCK_FALLBACK_ENABLED=false
HERMES_CONTROL_HERMES_DASHBOARD_URL=http://127.0.0.1:19119
HERMES_CONTROL_HERMES_DASHBOARD_WS=ws://127.0.0.1:19119/api/ws
HERMES_CONTROL_HERMES_API_URL=http://127.0.0.1:18642
HERMES_CONTROL_HERMES_DASHBOARD_TOKEN=REPLACE_WITH_BACKEND_ONLY_TOKEN
HERMES_CONTROL_HERMES_API_KEY=REPLACE_WITH_BACKEND_ONLY_KEY
# Optional local, read-only projection for voice notes. A Mac backend connected
# only through SSH tunnels cannot read this remote filesystem path.
HERMES_CONTROL_HERMES_MEDIA_ROOT=~/.hermes/profiles
HERMES_CONTROL_HERMES_MEDIA_MAX_BYTES=52428800
# Exact 40-hex commit verified out of band; leave empty for read-only mode.
HERMES_CONTROL_HERMES_SOURCE_SHA=
HERMES_CONTROL_DEFAULT_GATEWAY_NAME=Hermes remoto
HERMES_CONTROL_DEFAULT_PROFILES=default,jarvis,control-dev
# Conversation-only operations available to the user's normal agents.
HERMES_CONTROL_INTERACTIVE_PROFILES=default,jarvis,control-dev
# Full administrative/destructive operations remain isolated to control-dev.
HERMES_CONTROL_MUTABLE_PROFILES=control-dev
HERMES_CONTROL_TRUST_PRIVATE_ENDPOINTS=true
